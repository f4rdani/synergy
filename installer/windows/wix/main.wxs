<?xml version='1.0' encoding='windows-1252'?>
<!--
  Synergy MSI Installer
  Built with cargo-wix: cargo wix --no-build --nocapture
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='Synergy'
        UpgradeCode='A1B2C3D4-E5F6-7890-ABCD-EF1234567890'
        Manufacturer='Synergy Contributors'
        Language='1033'
        Codepage='1252'
        Version='0.2.0'>

        <Package Id='*'
            Keywords='Installer'
            Description='Synergy - Multi-App AI Workspace Orchestrator'
            Manufacturer='Synergy Contributors'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252' />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.' />

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1' />
        <Property Id='DiskPrompt' Value='Synergy Installation' />

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='ProgramFiles64Folder' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Synergy'>
                    <Component Id='binary0' Guid='*'>
                        <File
                            Id='exe0'
                            Name='synergy-app.exe'
                            DiskId='1'
                            Source='target\release\synergy-app.exe'
                            KeyPath='yes' />
                    </Component>
                </Directory>
            </Directory>

            <!-- Start Menu shortcut -->
            <Directory Id='ProgramMenuFolder' Name='Programs'>
                <Directory Id='ApplicationProgramsFolder' Name='Synergy'>
                    <Component Id='ApplicationShortcut' Guid='*'>
                        <Shortcut Id='ApplicationStartMenuShortcut'
                            Name='Synergy'
                            Description='Multi-App AI Workspace Orchestrator'
                            Target='[#exe0]'
                            WorkingDirectory='APPLICATIONFOLDER' />
                        <RemoveFolder Id='CleanUpShortCut' Directory='ApplicationProgramsFolder' On='uninstall' />
                        <RegistryValue Root='HKCU' Key='Software\Synergy' Name='installed' Type='integer' Value='1' KeyPath='yes' />
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs the Synergy application.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='binary0' />
            <Feature
                Id='StartMenu'
                Title='Start Menu Shortcut'
                Level='1'>
                <ComponentRef Id='ApplicationShortcut' />
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize' />

        <Icon Id='ProductICO' SourceFile='crates\synergy-app\icons\icon.ico' />
        <Property Id='ARPPRODUCTICON' Value='ProductICO' />
        <Property Id='ARPHELPLINK' Value='https://github.com/user/synergy' />

        <UI>
            <UIRef Id='WixUI_FeatureTree' />
        </UI>
        <WixVariable Id='WixUILicenseRtf' Value='LICENSE-MIT' />
    </Product>
</Wix>
